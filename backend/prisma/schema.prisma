// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  role       Role        @default(USER)
  createdAt  DateTime    @default(now())
  cards      Card[]
  accessLogs AccessLog[]
}

enum Role {
  ADMIN
  USER
}

model Device {
  id         String       @id @default(cuid())
  name       String
  type       DeviceType   @default(SMART_LOCK)
  mqttTopic  String       @unique // vd: device/lock-01
  status     DeviceStatus @default(OFFLINE)
  lastSeenAt DateTime?
  accessLogs AccessLog[]
  cards      Card[]
}

enum DeviceType {
  SMART_LOCK
  SENSOR
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

model Card {
  id      String   @id @default(cuid())
  uid     String   @unique // mã thẻ NFC
  label   String?
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  devices Device[]
  active  Boolean  @default(true)
}

model AccessLog {
  id        String       @id @default(cuid())
  device    Device       @relation(fields: [deviceId], references: [id])
  deviceId  String
  user      User?        @relation(fields: [userId], references: [id])
  userId    String?
  cardUid   String
  result    AccessResult
  createdAt DateTime     @default(now())
}

enum AccessResult {
  GRANTED
  DENIED
}